# Copy to .env.local and fill in values from Firebase console / `firebase apps:sdkconfig`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=staysticky-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=staysticky-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=staysticky-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Chrome extension ID after loading unpacked (chrome://extensions)
NEXT_PUBLIC_EXTENSION_ID=
